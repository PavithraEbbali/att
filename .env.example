# ─────────────────────────────────────────────────────────────────────────────
# §8 business-identity constants.
#
# Copy to .env.local for local dev, and set the same keys in the Vercel project
# (Settings → Environment Variables) for deployments.
#
# Every value here is PRINTED ON THE PAGE, so none of it is secret and
# NEXT_PUBLIC_ is correct. There are no API keys or credentials in this project.
#
# Behaviour when a value is missing:
#   · preview / local build -> renders "[Contact info pending]", build continues
#   · production build      -> build FAILS (npm run check:constants --strict)
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_WORDMARK=

# Must match the signed AT&T program agreement: Reseller | Retailer | Dealer | Agent
NEXT_PUBLIC_AGREEMENT_NOUN=Reseller

# Display form, e.g. (888) 123-4567
# Numbers in the 555-01xx range are rejected by the build gate (reserved for fiction).
NEXT_PUBLIC_PHONE_DISPLAY=
# E.164 form for the tel: link, e.g. +18881234567
NEXT_PUBLIC_PHONE_E164=

NEXT_PUBLIC_HOURS=
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_ADDRESS=

# Production origin, used for canonical URLs and JSON-LD, e.g. https://example.com
# Set this to the real custom domain (or the Vercel production domain) before launch.
NEXT_PUBLIC_ORIGIN=
